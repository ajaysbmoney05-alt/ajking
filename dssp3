QUESTION 1 – CURSOR
----------------------------------------

11. Procedure paste karo:

CREATE OR REPLACE PROCEDURE show_rdbms_teacher(s_no_input INTEGER)
LANGUAGE plpgsql
AS $$
DECLARE
 rec RECORD;
 cur CURSOR FOR
 SELECT s.s_name, t.t_name
 FROM Student s
 JOIN Student_Teacher st ON s.s_no = st.s_no
 JOIN Teacher t ON st.t_no = t.t_no
 WHERE s.s_no = s_no_input
 AND st.subject = 'RDBMS';
BEGIN
 OPEN cur;
 LOOP
  FETCH cur INTO rec;
  EXIT WHEN NOT FOUND;
  RAISE NOTICE 'Student: %, Teacher: %',
  rec.s_name, rec.t_name;
 END LOOP;
 CLOSE cur;
END;
$$;


12. Run:

CALL show_rdbms_teacher(1);

Output:
NOTICE: Student: Ajay, Teacher: Rahul


